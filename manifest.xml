<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>2f1c5b4b-56b8-4e18-bca1-9a310c2db702</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Contoso</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="OpenAI Word Assistant" />
  <Description DefaultValue="Task pane add-in that sends selections to OpenAI and reinserts the response." />
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.svg" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-64.svg" />
  <SupportUrl DefaultValue="https://localhost:3000" />
  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
    <AppDomain>https://api.openai.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.3" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides Version="1.0" xsi:type="ov:TaskPaneApp">
    <ov:Hosts>
      <ov:Host xsi:type="ov:Document">
        <ov:DesktopFormFactor>
          <ov:FunctionFile resid="functionFile" />
          <ov:GetStarted>
            <ov:Title resid="getStartedTitle" />
            <ov:Description resid="getStartedDescription" />
            <ov:LearnMoreUrl resid="learnMoreUrl" />
          </ov:GetStarted>
          <ov:ExtensionPoint xsi:type="ov:PrimaryCommandSurface">
            <ov:OfficeTab id="TabHome">
              <ov:Group id="TaskpaneGroup">
                <ov:Label resid="groupLabel" />
                <ov:Icon>
                  <ov:bt:Image size="16" resid="icon16" />
                  <ov:bt:Image size="32" resid="icon32" />
                  <ov:bt:Image size="80" resid="icon80" />
                </ov:Icon>
                <ov:Control xsi:type="ov:Button" id="TaskpaneButton">
                  <ov:Label resid="buttonLabel" />
                  <ov:Supertip>
                    <ov:Title resid="buttonLabel" />
                    <ov:Description resid="buttonDescription" />
                  </ov:Supertip>
                  <ov:Icon>
                    <ov:bt:Image size="16" resid="icon16" />
                    <ov:bt:Image size="32" resid="icon32" />
                    <ov:bt:Image size="80" resid="icon80" />
                  </ov:Icon>
                  <ov:Action xsi:type="ov:ShowTaskpane">
                    <ov:SourceLocation resid="taskpaneUrl" />
                  </ov:Action>
                </ov:Control>
              </ov:Group>
            </ov:OfficeTab>
          </ov:ExtensionPoint>
        </ov:DesktopFormFactor>
      </ov:Host>
    </ov:Hosts>
    <ov:Resources>
      <ov:bt:Images>
        <ov:bt:Image id="icon16" DefaultValue="https://localhost:3000/assets/icon-16.svg" />
        <ov:bt:Image id="icon32" DefaultValue="https://localhost:3000/assets/icon-32.svg" />
        <ov:bt:Image id="icon80" DefaultValue="https://localhost:3000/assets/icon-80.svg" />
      </ov:bt:Images>
      <ov:bt:Urls>
        <ov:bt:Url id="functionFile" DefaultValue="https://localhost:3000/taskpane.html" />
        <ov:bt:Url id="learnMoreUrl" DefaultValue="https://learn.microsoft.com/office/dev/add-ins/overview/office-add-ins" />
        <ov:bt:Url id="taskpaneUrl" DefaultValue="https://localhost:3000/taskpane.html" />
      </ov:bt:Urls>
      <ov:bt:ShortStrings>
        <ov:bt:String id="groupLabel" DefaultValue="OpenAI Assistant" />
        <ov:bt:String id="buttonLabel" DefaultValue="OpenAI Assistant" />
        <ov:bt:String id="getStartedTitle" DefaultValue="Get started" />
      </ov:bt:ShortStrings>
      <ov:bt:LongStrings>
        <ov:bt:String id="buttonDescription" DefaultValue="Launch the OpenAI task pane." />
        <ov:bt:String id="getStartedDescription" DefaultValue="Open the task pane to send selections to OpenAI." />
      </ov:bt:LongStrings>
    </ov:Resources>
  </VersionOverrides>
</OfficeApp>
